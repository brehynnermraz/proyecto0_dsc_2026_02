# Variables del worker. Copia a .env y ajústalas, o expórtalas a mano.
#
#   export $(grep -v '^#' .env | xargs)

# Broker RabbitMQ
AMQP_URL=amqp://guest:guest@localhost:5672/

# Base de datos (PASO 2). OBLIGATORIA: el worker es la fuente de verdad del estado.
# Postgres nativo, base okf_learning, usuario del SO con trust auth (sin password):
DATABASE_URL=postgres://esanto@localhost:5432/okf_learning
# PG_MAX_CONNS=4          # conexiones del pool por réplica (n_réplicas × esto < max_connections)
# JOB_HEARTBEAT_INTERVAL=10s   # cada cuánto renueva el lease el worker
# JOB_LEASE_TTL=30s            # tras cuánto sin latido otro worker puede re-tomar (> heartbeat)
# JOB_TIMEOUT=5m               # tope de duración de un trabajo
# MAX_INPUT_BYTES=52428800     # tope de lectura del original (50 MiB)

# Almacenamiento de objetos. STORAGE_BACKEND elige el adaptador:
#   fs   -> carpeta local (rápido para probar sin levantar el servicio)
#   http -> servicio object-storage por red (patrón real, sin compartir disco)
STORAGE_BACKEND=fs

# Backend fs: raíz local donde cuelgan originals/ y bundles/
STORAGE_DIR=./data/objects

# Backend http: URL del servicio y token compartido (mismo STORAGE_TOKEN del servicio).
# Levanta el servicio desde ../object-storage y pon STORAGE_BACKEND=http para usarlo.
# STORAGE_BASE_URL=http://localhost:9000
# STORAGE_TOKEN=secreto

# Simulación del trabajo — solo la usa el SimulatedProcessor (paso 1), ya no se enchufa
SIMULATE_WORK=2s
SIMULATE_FAILURE=false

# Logs
LOG_LEVEL=info
LOG_FORMAT=text


# ============================================================================
# API (../backend) — usa el MISMO Postgres y el MISMO object-storage que arriba
# ============================================================================
# POSTGRES_DSN=postgres://esanto@localhost:5432/okf_learning?sslmode=disable
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/
# STORAGE_BASE_URL=http://localhost:9000   # servicio ../object-storage
# STORAGE_TOKEN=secreto                    # el MISMO valor que arriba y que el servicio
# JWT_SECRET=cambia-esto
# FRONTEND_ORIGIN=http://localhost:3000
# PORT=8080


# ============================================================================
# Docker Compose (docker-compose.yml en la raíz) — levanta los 5 servicios
# de una vez: postgres, rabbitmq, object-storage, api y worker. Compose arma
# DATABASE_URL/AMQP_URL/POSTGRES_DSN/RABBITMQ_URL a partir de estas piezas,
# así que aquí NO se pega la URL completa, solo las credenciales.
# ============================================================================
POSTGRES_USER=okf
POSTGRES_PASSWORD=okf
POSTGRES_DB=okf

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Compartido por api, worker y object-storage: sin él, object-storage no
# arranca (Validate() lo exige) y api/worker no pueden leer ni escribir nada.
STORAGE_TOKEN=cambia-esto

JWT_SECRET=cambia-esto
FRONTEND_ORIGIN=http://localhost:3000

# URL de la API que USA EL NAVEGADOR (se incrusta en el build del frontend). Por
# defecto el puerto publicado en el host; cámbialo solo si publicas la API en otro
# sitio. Al cambiarlo hay que reconstruir: docker compose build frontend
# NEXT_PUBLIC_API_URL=http://localhost:8080

# docker compose up --scale worker=3   # más réplicas del worker, sin tocar nada más
